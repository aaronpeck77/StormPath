# Vite production mode (`npm run build` / App Store customer IPA via `build:ios:appstore`).
# Mapbox / weather / Sentry / RevenueCat keys are injected at build time from GitHub Secrets
# or your local gitignored `.env` — never commit secrets here.

# --- Tier ---------------------------------------------------------------------
# Omit VITE_PAY_TIER so customers start on Basic. Plus unlocks via RevenueCat IAP
# (entitlement mirrored into safeStorage by `revenueCat.ts`).

# --- Support / legal links ----------------------------------------------------
VITE_SUPPORT_EMAIL=stormpath@yahoo.com
VITE_SUPPORT_URL=https://stormpath2.netlify.app/support.html
VITE_PRIVACY_POLICY_URL=https://stormpath2.netlify.app/privacy.html
VITE_TERMS_URL=https://stormpath2.netlify.app/terms.html

# --- NWS contact (api.weather.gov User-Agent) --------------------------------
VITE_WEATHER_ALERT_USER_AGENT=StormPath/1.0 (+https://stormpath2.netlify.app/ contact: stormpath@yahoo.com)

# --- About → Test pay tier panel ---------------------------------------------
# Must stay off for App Store review. Internal QA only: VITE_PAY_TIER_TEST_PANEL=true

# --- Basic tier ads -----------------------------------------------------------
VITE_ADMOB_BANNER_UNIT_ID=ca-app-pub-3213710841500662/1583758564
# Do not set VITE_ADMOB_TEST_MODE=true on retail builds.

# --- RevenueCat IAP -----------------------------------------------------------
# Set in GitHub Actions secret VITE_REVENUECAT_API_KEY_IOS for App Store builds.
# VITE_REVENUECAT_API_KEY_IOS=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
