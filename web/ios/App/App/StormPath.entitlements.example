<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copy to StormPath.entitlements and set CODE_SIGN_ENTITLEMENTS only AFTER Apple
  grants the CarPlay navigation entitlement. See docs/CARPLAY.md.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.carplay-maps</key>
	<true/>
</dict>
</plist>
