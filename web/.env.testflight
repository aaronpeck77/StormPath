# Vite `--mode testflight` (see `npm run build:testflight` in web/package.json).
# Loaded together with your gitignored `.env` / `.env.local` (tokens stay local).
#
# Keeps internal TestFlight / QA IPAs aligned with local `npm run dev` (both default to Plus for feature work).
# For App Store *customer* submission, use `npm run build` only — do not use this mode, or set VITE_PAY_TIER=free.

# --- Tier ---------------------------------------------------------------------
# Force Plus on internal TestFlight binaries so testers can exercise the full app.
VITE_PAY_TIER=plus

# --- Support / legal links ----------------------------------------------------
# Inbox for About → Support diagnostics email. Role address only — never a personal one.
VITE_SUPPORT_EMAIL=stormpath@yahoo.com
# Public site: Netlify site name "stormpath2" — https://stormpath2.netlify.app (see docs/NETLIFY_HOSTING.md)
VITE_SUPPORT_URL=https://stormpath2.netlify.app/support.html
VITE_PRIVACY_POLICY_URL=https://stormpath2.netlify.app/privacy.html
VITE_TERMS_URL=https://stormpath2.netlify.app/terms.html

# --- NWS contact (api.weather.gov User-Agent) --------------------------------
# Identifies the TestFlight build to api.weather.gov so traffic patterns are
# distinguishable from local dev / Netlify. Contact uses the support inbox above.
VITE_WEATHER_ALERT_USER_AGENT=StormPath/1.0 TestFlight (+https://stormpath2.netlify.app/ contact: stormpath@yahoo.com)

# --- About → Test pay tier panel ---------------------------------------------
# On for owner QA: switch Basic in About → i to test AdMob + Basic limits. Turn off before App Store review.
VITE_PAY_TIER_TEST_PANEL=true

# --- Basic tier ads (QA on TestFlight — switch to Basic in About test panel) ---
VITE_ADMOB_BANNER_UNIT_ID=ca-app-pub-3213710841500662/1583758564

# --- Optional --------------------------------------------------------------
# Upgrade / manage links shown in About → Subscription. Leave blank until billing
# is real; the app falls back to a description-only row when these aren't set.
# VITE_UPGRADE_URL=
# VITE_MANAGE_SUBSCRIPTION_URL=
# Promo rotation in the Basic advisory strip. Leave blank until SiteBible has a
# real landing page; the bar still shows the "Coming Soon" copy from code.
# VITE_SITEBIBLE_URL=

# --- RevenueCat IAP (Phase 7) ------------------------------------------------
# When set, AboutSheet shows native Subscribe + Restore buttons (RevenueCat → App Store).
# Until the dashboard + App Store Connect setup in `.env.example` is finished, leave this
# commented out — TestFlight users still get Plus for free via VITE_PAY_TIER=plus above,
# so beta access isn't blocked while you wire RevenueCat. See `src/billing/revenueCat.ts`.
# VITE_REVENUECAT_API_KEY_IOS=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
