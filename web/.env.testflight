# Vite `--mode testflight` (see `npm run build:testflight` in web/package.json).
# Loaded together with your gitignored `.env` / `.env.local` (tokens stay local).
#
# Keeps internal TestFlight / QA IPAs aligned with local `npm run dev` (both default to Plus for feature work).
# For App Store *customer* submission, use `npm run build` only — do not use this mode, or set VITE_PAY_TIER=free.

# --- Tier ---------------------------------------------------------------------
# Force Plus on internal TestFlight binaries so testers can exercise the full app.
VITE_PAY_TIER=plus

# --- Support / legal links ----------------------------------------------------
# Inbox for About → Support diagnostics email. Role address only — never a personal one.
VITE_SUPPORT_EMAIL=stormpath@yahoo.com
# Support page bundled with the build (web/dist/support.html). Override here if you
# add a hosted support site before public release.
VITE_SUPPORT_URL=/support.html
VITE_PRIVACY_POLICY_URL=/privacy.html
VITE_TERMS_URL=/terms.html

# --- NWS contact (api.weather.gov User-Agent) --------------------------------
# Identifies the TestFlight build to api.weather.gov so traffic patterns are
# distinguishable from local dev / Netlify. Contact uses the support inbox above.
VITE_WEATHER_ALERT_USER_AGENT=StormPath/1.0 TestFlight (+https://stormpath.netlify.app/ contact: stormpath@yahoo.com)

# --- About → Test pay tier panel ---------------------------------------------
# Internal TestFlight only — leave true here so we can flip Basic/Plus on device
# during the closed test. Customer App Store builds must omit this (default false).
VITE_PAY_TIER_TEST_PANEL=true

# --- Optional --------------------------------------------------------------
# Upgrade / manage links shown in About → Subscription. Leave blank until billing
# is real; the app falls back to a description-only row when these aren't set.
# VITE_UPGRADE_URL=
# VITE_MANAGE_SUBSCRIPTION_URL=
# Promo rotation in the Basic advisory strip. Leave blank until SiteBible has a
# real landing page; the bar still shows the "Coming Soon" copy from code.
# VITE_SITEBIBLE_URL=
