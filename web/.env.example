# Copy this file to `.env` or `.env.local` in this `web/` folder and fill values there.
# Do NOT put real API keys in `.env.example` — that file is often committed to git.
#
# Dev vs TestFlight (same codebase): local work uses `npm run dev`. For TestFlight IPAs that should
# behave like dev (Plus on), run `npm run build:ios:testflight` — it uses committed `.env.testflight`.
# See docs/DEV_AND_TESTFLIGHT_WORKFLOW.md

# Experimental radar-intersect along route (Route Info + advisory). On by default; set false to disable.
# VITE_STORM_CORRIDOR_INTERSECT=false

# Mapbox — map + geocoding + directions + live traffic ETAs (Directions API driving-traffic profile).
# Use a **public** token. In Mapbox → Tokens → URL restrictions, add every origin you use
# (e.g. https://stormpath2.netlify.app/*, your custom domain, and http://192.168.*.*:5173/* for phone-on-Wi‑Fi dev).
# Netlify site name: stormpath2 — see docs/NETLIFY_HOSTING.md
VITE_MAPBOX_TOKEN=

# OpenWeather — current weather along route samples (https://openweathermap.org/api)
VITE_OPENWEATHER_API_KEY=

# Tomorrow.io — minute-by-minute precipitation nowcast + hourly route forecast (https://tomorrow.io)
# Free tier: 500 req/day, 25 req/hr. Sign up at https://app.tomorrow.io/signup
# Plus-only feature: hourly forecast along the active route. Minute precip shown to all tiers.
# TestFlight / GitHub Actions: add the same value as repo secret VITE_TOMORROW_IO_API_KEY (vite build bakes it in).
VITE_TOMORROW_IO_API_KEY=
# Optional native map-radar tile proxy.
# App Store scale: deploy Cloudflare Worker — see docs/CLOUDFLARE_TILES.md
# Fallback / launch: https://stormpath2.netlify.app/.netlify/functions/tomorrow-io-tile
# VITE_TOMORROW_IO_TILE_PROXY_URL=https://stormpath-tomorrow-io-tiles.YOUR_SUBDOMAIN.workers.dev/tomorrow-io-tile

# Apple WeatherKit — App Store scale (500k calls/month). Requires Netlify JWT function — see docs/WEATHERKIT_SETUP.md
# When true, route/point forecasts use WeatherKit instead of Tomorrow.io / OpenWeather.
# VITE_WEATHERKIT_ENABLED=true
# Optional token URL (native default: https://stormpath2.netlify.app/.netlify/functions/weatherkit-token)
# VITE_WEATHERKIT_TOKEN_URL=

# Control Room usage/Jeff reporting — write-only token the app uses to POST Mapbox usage
# counts and Jeff the Fix-It Bot activity to ops-usage / ops-jeff.
# Must be the SAME value as OPS_USAGE_INGEST_TOKEN + VITE_OPS_USAGE_INGEST_TOKEN on Netlify.
# TestFlight / GitHub Actions: add the same value as repo secret VITE_OPS_USAGE_INGEST_TOKEN
# (vite build bakes it in) — without this, driving on a TestFlight/App Store build never
# reports anything and the Control Room stays empty even though Netlify is configured.
VITE_OPS_USAGE_INGEST_TOKEN=

# Support contact for About → Support and diagnostics email (defaults to stormpath@yahoo.com if omitted).
# VITE_SUPPORT_EMAIL=stormpath@yahoo.com
# Optional support site (defaults to /support.html if omitted).
VITE_SUPPORT_URL=

# api.weather.gov User-Agent contact (URL or role email — never your personal email).
# Format: "StormPath/1.0 (+https://your.site/ or support@your.domain)"
VITE_WEATHER_ALERT_USER_AGENT=

# Optional legal links shown in About -> Privacy, safety & data.
VITE_PRIVACY_POLICY_URL=
VITE_TERMS_URL=

# Subscription buttons in About -> Subscription (optional).
# Upgrade: App Store app/product page, Stripe checkout, or your marketing URL — set when billing is live.
# Example App Store: https://apps.apple.com/app/id1234567890
VITE_UPGRADE_URL=
# Manage: Apple account subscriptions page (default in app) or Stripe Customer Portal / your account URL.
# VITE_MANAGE_SUBSCRIPTION_URL=https://apps.apple.com/account/subscriptions

# --- RevenueCat IAP (iOS / Phase 7) -------------------------------------------
# When set, the AboutSheet Subscription panel shows native "Subscribe" + "Restore Purchases"
# buttons that talk to App Store via RevenueCat. When empty, the panel falls back to the
# VITE_UPGRADE_URL link above.
#
# Setup checklist (do all four before TestFlight ships with this build):
#   1. App Store Connect → create one or more auto-renewable subscription products
#      (e.g. stormpath.plus.monthly, stormpath.plus.yearly) inside a subscription group.
#      Add localized display name, price tier, and the required intro / free-trial copy.
#   2. RevenueCat dashboard (app.revenuecat.com) → create a project for the iOS bundle id,
#      import the App Store products, attach them to an entitlement named exactly **plus**
#      (lower-case — must match STORMPATH_PLUS_ENTITLEMENT_ID in src/billing/revenueCat.ts).
#   3. RevenueCat dashboard → create an Offering, add the product packages to it, mark it
#      "current". Without a current offering `getPlusOffering()` returns null and the UI
#      stays on the URL fallback.
#   4. RevenueCat dashboard → Project Settings → API keys → copy the iOS public SDK key
#      (starts with appl_) and paste below.
#
# VITE_REVENUECAT_API_KEY_IOS=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — App Store product page for SiteBible (Basic status panel partner link).
# VITE_SITEBIBLE_URL=https://apps.apple.com/app/idXXXXXXXXX

# Optional — third sponsored slot in Basic status panel (set URL to show the partner row).
# VITE_PARTNER_AD_URL=https://example.com/partner

# Optional — override or add Basic-tier promo lines (JSON array). Each item: id, text, optional detailText, href, sponsored.
# VITE_BASIC_ADS_JSON=[{"id":"sitebible","text":"SiteBible — security database","href":"https://…","sponsored":true}]

# --- Basic tier ads (App Store customer build only — not TestFlight Plus) -----------------
# Step 1: Create account at https://admob.google.com → Apps → Add StormPath (iOS).
# Step 2: Create a Banner ad unit; paste the unit id below.
# Step 3: GADApplicationIdentifier in ios/App/App/Info.plist (App ID, ca-app-pub-…~…).
# Step 4: Paste banner unit id below in `.env.production` (gitignored) for App Store Basic builds.
# Until VITE_ADMOB_BANNER_UNIT_ID is set, native builds fall back to Google test banner creatives.
#
# VITE_ADMOB_BANNER_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
# Set true on internal TestFlight / QA only — serves Google test banner creatives (not paid fill).
# Omit or false for App Store customer builds.
# VITE_ADMOB_TEST_MODE=true

# Plan: "plus" forces Plus on that binary (Netlify, Xcode archive, internal TestFlight). Omit for customer App Store / Play = Basic.
# VITE_PAY_TIER=plus
# Optional: "free" during dev to force Basic even with hot reload (overrides dev-default Plus).
# VITE_PAY_TIER=free

# About → "Test pay tier" panel. Production default: **hidden**. Set to "true" only for internal QA IPAs/APKs.
# VITE_PAY_TIER_TEST_PANEL=true

# Native Plus unlock (Capacitor) before IAP is wired — QA only; see docs/MOBILE_STORE_RELEASE.md
# localStorage key: stormpath-native-plus-entitlement = "active"

# Sentry crash reporting (optional). GitHub Actions: repository secret VITE_SENTRY_DSN — see docs/SENTRY_SETUP.md
# VITE_SENTRY_DSN=
