# Copy to .env on Forge (never commit .env)
PORT=8787
HOST=127.0.0.1

# WeatherKit JWT (same values as Netlify)
WEATHERKIT_TEAM_ID=
WEATHERKIT_KEY_ID=
WEATHERKIT_SERVICE_ID=
WEATHERKIT_PRIVATE_KEY=

# Control Room
OPS_HUB_SECRET=
# Write-only token for app Mapbox usage reports (also set VITE_OPS_USAGE_INGEST_TOKEN on the web build)
OPS_USAGE_INGEST_TOKEN=

# Optional income / probes
REVENUECAT_SECRET_API_KEY=
REVENUECAT_PROJECT_ID=
TOMORROW_IO_TILE_PROXY_URL=
SITE_URL=https://stormpath2.netlify.app
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
