{
  "name": "stormpath-web",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:netlify": "npm run build && node scripts/verify-netlify-dist.mjs",
    "build:testflight": "tsc --noEmit && vite build --mode testflight",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "npx cap sync ios",
    "sync:ios-version": "node scripts/sync-ios-version.mjs",
    "build:ios": "npm run build && npm run sync:ios-version && npx cap sync ios",
    "build:ios:testflight": "npm run build:testflight && npm run sync:ios-version && npx cap sync ios",
    "render:app-icon": "node scripts/render-app-icon.mjs",
    "render:app-icon:rainbow": "node scripts/render-app-icon.mjs rainbow",
    "validate:app-icon": "node scripts/validate-app-icon.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@revenuecat/purchases-capacitor": "^13.1.3",
    "@sentry/react": "^10.54.0",
    "mapbox-gl": "^3.24.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
