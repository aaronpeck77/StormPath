{
  "name": "stormpath-web",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:netlify": "npm run build && node scripts/verify-netlify-dist.mjs",
    "build:testflight": "tsc --noEmit && vite build --mode testflight",
    "preview": "vite preview",
    "cap:sync": "npx cap sync ios",
    "sync:ios-version": "node scripts/sync-ios-version.mjs",
    "build:ios": "npm run build && npm run sync:ios-version && npx cap sync ios",
    "build:ios:testflight": "npm run build:testflight && npm run sync:ios-version && npx cap sync ios",
    "render:app-icon": "node scripts/render-app-icon.mjs"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/ios": "^8.3.1",
    "@sentry/react": "^10.53.1",
    "mapbox-gl": "^3.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "~5.6.2",
    "vite": "^5.4.10"
  }
}
